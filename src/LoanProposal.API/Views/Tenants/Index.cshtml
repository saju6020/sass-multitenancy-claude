@model TenantListViewModel
@{
    ViewData["Title"] = "Platform Tenants";
}

<div class="page-header">
    <div>
        <h1 class="h3 mb-1">Platform Tenants</h1>
        <p class="text-secondary mb-0">Provision and monitor financial institutions on the SaaS platform.</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-4">
        <form class="workspace-card p-3" asp-controller="Tenants" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <h2 class="h5 mb-3">New Tenant</h2>
            <div class="mb-3">
                <label asp-for="Form.Name" class="form-label">Name</label>
                <input asp-for="Form.Name" class="form-control" placeholder="Pacific Lending Co" />
            </div>
            <div class="mb-3">
                <label asp-for="Form.Slug" class="form-label">Slug</label>
                <input asp-for="Form.Slug" class="form-control" placeholder="pacific-lending" />
            </div>
            <div class="row g-3">
                <div class="col-sm-5">
                    <label asp-for="Form.Currency" class="form-label">Currency</label>
                    <input asp-for="Form.Currency" class="form-control" maxlength="3" />
                </div>
                <div class="col-sm-7">
                    <label asp-for="Form.Timezone" class="form-label">Timezone</label>
                    <input asp-for="Form.Timezone" class="form-control" placeholder="Asia/Dhaka" />
                </div>
            </div>
            <button class="btn btn-primary mt-3" type="submit">Provision Tenant</button>
        </form>
    </div>

    <div class="col-xl-8">
        <div class="workspace-card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tenant</th>
                            <th>Currency</th>
                            <th class="text-end">Applications</th>
                            <th class="text-end">Fields</th>
                            <th class="text-end">Rules</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var tenant in Model.Tenants)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@tenant.Name</div>
                                <div class="text-secondary small">@tenant.Slug</div>
                            </td>
                            <td>@tenant.Currency</td>
                            <td class="text-end">@tenant.ApplicationCount</td>
                            <td class="text-end">@tenant.CustomFieldCount</td>
                            <td class="text-end">@tenant.RuleCount</td>
                            <td><span class="badge @(tenant.IsActive ? "text-bg-success" : "text-bg-secondary")">@(tenant.IsActive ? "Active" : "Inactive")</span></td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" asp-controller="Tenants" asp-action="Edit" asp-route-id="@tenant.Id">Edit</a>
                                <form class="d-inline" asp-controller="Tenants" asp-action="Delete" asp-route-id="@tenant.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
